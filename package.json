{
  "name": "personal-website",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "generate:outdoor-manifest": "node scripts/generate-outdoor-photo-manifest.mjs",
    "generate:open-library-books": "node scripts/generate-open-library-books.mjs",
    "generate:prebuild": "pnpm run generate:outdoor-manifest && pnpm run generate:open-library-books",
    "predev": "pnpm run generate:prebuild",
    "dev": "next dev",
    "prebuild": "pnpm run generate:prebuild",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "typecheck": "tsc --noEmit",
    "test:build": "pnpm run generate:outdoor-manifest && pnpm exec next build",
    "test:e2e": "pnpm run test:build && playwright test",
    "test:e2e:run": "playwright test",
    "test:e2e:ui": "playwright test --ui"
  },
  "dependencies": {
    "framer-motion": "^11.18.2",
    "next": "16.2.6",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@playwright/test": "^1.63.0",
    "@tailwindcss/postcss": "^4",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/node": "^24.13.6",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^6.1.1",
    "@vitest/coverage-v8": "^5.0.1",
    "eslint": "^9",
    "eslint-config-next": "16.2.6",
    "jsdom": "^30.1.0",
    "sharp": "^0.34.5",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^5.0.1"
  }
}
